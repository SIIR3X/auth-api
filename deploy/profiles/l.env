# Profile L: up to 5 million accounts, 150 sign-ins per second at peak.
# Four instances: add docker-compose.api.l.yml. API VPS: 20 vCPU, 8 GB RAM.
# Sizing rules: docs/deploy/guides/operations.md, section 9.
API_CPUS=4
API_MEMORY=512M
API_MEMORY_RESERVATION=256M
ARGON2_MAX_CONCURRENCY=4
DB_MAX_CONNECTIONS=16
REDIS_POOL_SIZE=16
NATS_CPUS=1
NATS_MEMORY=256M
NATS_GOMEMLIMIT=200MiB
