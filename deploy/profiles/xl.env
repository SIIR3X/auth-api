# Profile XL: up to 20 million accounts, 450 sign-ins per second at peak.
# Three API hosts, each running profile L's four instances (docker-compose.api.l.yml),
# behind the load balancers of docs/deploy/guides/high-availability.md.
# Per host: 20 vCPU, 8 GB RAM. PostgreSQL: a primary and two replicas behind HAProxy,
# lag-tolerant reads on DATABASE_READ_URL.
# Extrapolated from the measured per-CPU rate, not validated by `make sizing`:
# docs/deploy/guides/operations.md, section 9.
API_CPUS=4
API_MEMORY=512M
API_MEMORY_RESERVATION=256M
ARGON2_MAX_CONCURRENCY=4
DB_MAX_CONNECTIONS=12
REDIS_POOL_SIZE=16
NATS_CPUS=1
NATS_MEMORY=256M
NATS_GOMEMLIMIT=200MiB
